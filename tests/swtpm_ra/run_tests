#!/bin/bash
#
# Run the swtpm_ra remote-attestation configuration test-suite.
# The suite only needs Python 3 (standard library) plus the
# 'cryptography' package already required by the build environment.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${SCRIPT_DIR}"
python3 -m unittest discover -v -p 'test_*.py' "$@"
